# Variáveis de ambiente
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Koda Web

# Mapbox (mapa no dashboard — token público da conta Mapbox)
# https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Auth Configuration
VITE_STORAGE_PREFIX=koda_
VITE_ACCESS_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token

# --- E2E (Playwright) — só local; no CI vêm dos GitHub Secrets ---
# Conta no Supabase: e2e-admin@koda.com (não commitar senha)
E2E_ADMIN_EMAIL=e2e-admin@koda.com
E2E_ADMIN_PASSWORD=
# KODA_SERVER_DIR=/caminho/para/koda-server
